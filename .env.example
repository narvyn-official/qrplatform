# ── Core ─────────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=qrplatform.settings.production
SECRET_KEY=change-me-to-a-long-random-string-50-chars-minimum
JWT_SECRET_KEY=another-separate-secret-for-jwt-tokens
DEBUG=False

# ── Allowed hosts & CORS ──────────────────────────────────────────────────────
ALLOWED_HOSTS=qrplatform.io,www.qrplatform.io
CSRF_TRUSTED_ORIGINS=https://qrplatform.io,https://www.qrplatform.io
CORS_ALLOWED_ORIGINS=https://qrplatform.io

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=qrplatform
DB_USER=qrplatform
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@qrplatform.io
SERVER_EMAIL=errors@qrplatform.io

# ── Platform ──────────────────────────────────────────────────────────────────
PLATFORM_NAME=QRFlow
PLATFORM_DOMAIN=qrplatform.io
PLATFORM_URL=https://qrplatform.io
QR_REDIRECT_BASE=https://qrplatform.io/r/
SHORT_URL_BASE=https://qrfl.io/

# ── Payments (Paytm PG / UPI) ────────────────────────────────────────────────
PAYTM_ENVIRONMENT=staging
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE_NAME=WEBSTAGING

# ── Storage (optional S3) ─────────────────────────────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── GeoIP (MaxMind for production) ────────────────────────────────────────────
GEOIP_PATH=/app/geoip
